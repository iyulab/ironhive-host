<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- xUnit v3 test projects are stand-alone executables (BD-20260829-xunit-v3-pilot).
         OutputType=Exe activates NETSDK1151's self-contained-reference validation against
         IronHive.Cli (SelfContained=true) below; this project isn't meant to be launched
         standalone from IronHive.Cli's output folder, so the check is opted out per the
         documented fix (https://aka.ms/netsdk1151). -->
    <OutputType>Exe</OutputType>
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
    <IsTestProject>true</IsTestProject>

  </PropertyGroup>

  <ItemGroup>
    <!-- xUnit v3 pilot rollout: xunit replaced with xunit.v3, no Microsoft.NET.Test.Sdk (not
         required under Microsoft.Testing.Platform), coverlet.collector replaced with its
         MTP-native successor coverlet.MTP (this CI's coverage collection is real usage, not a
         dead reference), Xunit.SkippableFact dropped (unused after migrating McpServerE2ETests'
         [SkippableFact] uses to native xUnit v3 dynamic skip). xunit.runner.visualstudio kept
         for IDE Test Explorer discovery. -->
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- MTP equivalent of the ecosystem's VSTest blame-hang convention (BD-20260828-07) -->
    <PackageReference Include="Microsoft.Testing.Extensions.HangDump" />
    <PackageReference Include="coverlet.MTP" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Providers\Fixtures\filer-issue219-call*-messages.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\IronHive.Cli\IronHive.Cli.csproj" />
    <ProjectReference Include="..\..\src\IronHive.Host\IronHive.Host.csproj" />
  </ItemGroup>

</Project>
