<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Ignore NU1902 (known moderate vulnerabilities in transitive dependencies from upstream —
         MessagePack/Scriban via MCP+templating; no fixed release available yet). -->
    <!-- Ignore NU5104 (stable package with prerelease dependency: ModelContextProtocol has no GA release yet) -->
    <!-- NU1903 is deliberately NOT suppressed: the e_sqlite3 floor that motivated it cleared once the
         upstream iyulab pins were brought current (IronHive 0.14.0 / IndexThinking 0.21.1 /
         MemoryIndexer 0.16.1 all carry SQLitePCLRaw 2.1.12). A high-severity transitive must fail the
         build, not be hidden — a suppression here previously masked live advisories in ironhive-agent. -->
    <NoWarn>$(NoWarn);NU1902;NU5104</NoWarn>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>iyulab</Authors>
    <Company>iyulab</Company>
    <Product>IronHive Host</Product>
    <Copyright>Copyright (c) iyulab</Copyright>
    <RepositoryUrl>https://github.com/iyulab/ironhive-host</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <!-- Version: Update this to trigger a new release -->
  <PropertyGroup>
    <Version>0.19.1</Version>
  </PropertyGroup>

  <!-- Release build: exclude PDB files -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <!-- Local development packages (auto-detected, ignored in CI) -->
  <PropertyGroup Condition="Exists('$(MSBuildThisFileDirectory)../../local-packages')">
    <RestoreAdditionalProjectSources>$(RestoreAdditionalProjectSources);$(MSBuildThisFileDirectory)../../local-packages</RestoreAdditionalProjectSources>
  </PropertyGroup>
</Project>
