<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Microsoft.Extensions.AI (latest: 10.2.0) -->
    <PackageVersion Include="Ironbees.Core" Version="0.13.2" />
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.9.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.9.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.9.0" />
    <!-- OpenAI SDK -->
    <PackageVersion Include="ModelContextProtocol" Version="2.2.0" />
    <PackageVersion Include="OpenAI" Version="2.12.0" />
    <!-- Pin OpenTelemetry.Exporter.OpenTelemetryProtocol to non-vulnerable version (transitive from upstream) -->
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.15.3" />
    <!-- DI & Hosting (.NET 10) -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.11" />
    <!-- CLI & Console -->
    <PackageVersion Include="Spectre.Console" Version="0.55.2" />
    <PackageVersion Include="Spectre.Console.Cli" Version="0.55.0" />
    <!-- Diff -->
    <PackageVersion Include="DiffPlex" Version="1.9.0" />
    <!-- Glob -->
    <PackageVersion Include="Microsoft.Extensions.FileSystemGlobbing" Version="10.0.11" />
    <!-- YAML Config -->
    <PackageVersion Include="NetEscapades.Configuration.Yaml" Version="3.1.0" />
    <!-- .env support -->
    <PackageVersion Include="DotNetEnv" Version="3.2.0" />
    <!-- LMSupply packages (local AI inference fallback). 0.32.3 adds Gemma4
         RenderToolPromptFragment for Option D-1 (umbrella ISSUE 2026-04-30). -->
    <PackageVersion Include="LMSupply.Embedder" Version="0.42.10" />
    <PackageVersion Include="LMSupply.Reranker" Version="0.42.10" />
    <PackageVersion Include="LMSupply.Generator" Version="0.42.10" />
    <!-- MemoryIndexer (conversation memory, session management) -->
    <PackageVersion Include="MemoryIndexer" Version="0.16.8" />
    <PackageVersion Include="MemoryIndexer.Sdk" Version="0.16.8" />
    <!-- IronHive.Agent (reusable agent layer, from ironhive-agent repo) -->
    <PackageVersion Include="IronHive.Agent" Version="0.9.5" />
    <!-- IronHive (LLM abstraction) -->
    <PackageVersion Include="IronHive.Abstractions" Version="0.22.1" />
    <PackageVersion Include="IronHive.Core" Version="0.22.1" />
    <PackageVersion Include="IronHive.Providers.OpenAI" Version="0.22.1" />
    <PackageVersion Include="IronHive.Providers.Anthropic" Version="0.22.1" />
    <PackageVersion Include="IronHive.Providers.GoogleAI" Version="0.22.1" />
    <PackageVersion Include="IronHive.Providers.OpenAI.Compatible" Version="0.22.1" />
    <!-- WebLookup (web search) -->
    <PackageVersion Include="WebLookup" Version="0.2.1" />
    <!-- IronHive.DeepResearch (deep research agent) -->
    <PackageVersion Include="IronHive.DeepResearch" Version="0.9.5" />
    <!-- Cronex (scheduling) -->
    <PackageVersion Include="Cronex.Net" Version="0.6.0" />
    <PackageVersion Include="Cronex.Net.Hosting" Version="0.6.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
    <!-- TokenMeter (model catalog & cost calculation) -->
    <PackageVersion Include="TokenMeter" Version="0.7.3" />
    <!-- Testing (xUnit v3 / Microsoft.Testing.Platform — BD-20260829-xunit-v3-pilot rollout) -->
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.6.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.HangDump" Version="2.3.3" />
    <!-- coverlet.MTP is coverlet.collector's MTP-native successor (D357-1) -->
    <PackageVersion Include="coverlet.MTP" Version="10.0.1" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
  </ItemGroup>
</Project>